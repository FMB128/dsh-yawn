#!/bin/sh
# Boot the web profile. Extra container arguments are passed to the web app,
# so a manifest can add flags such as --trusted-host.
set -eu

# The image starts as root so this script can put dsh in the mounted Docker
# socket's group. A socket's group id only means something inside the container
# it is mounted into — under rootless or userns-remapped Docker the host-side
# value is not even mapped — so the run command cannot compute it and the
# lookup has to happen here. Root is given up before anything else runs:
# dsh-yawn-seed and dsh below are the image's normal user, uid 1000. A run that
# sets its own user (Kubernetes runAsUser) skips this block.
if [ "$(id -u)" = 0 ]; then
  socket_gid=1000
  if [ -S /var/run/docker.sock ]; then
    socket_gid=$(stat -c %g /var/run/docker.sock)
  fi
  exec setpriv --reuid=1000 --regid=1000 --groups 1000,"$socket_gid" \
    /usr/local/bin/dsh-yawn-entrypoint "$@"
fi

# Reached only when the run overrode the image user, which skips the group join
# above; say what is wrong instead of failing later inside the Docker backend.
if [ -S /var/run/docker.sock ] && [ ! -w /var/run/docker.sock ]; then
  echo "dsh-yawn: /var/run/docker.sock is not writable by uid $(id -u), so the Docker backend cannot start sandboxes." >&2
fi

dsh-yawn-seed

set -- --port "${DSH_YAWN_WEB_PORT:-3000}" --no-open "$@"
# DSH_YAWN_BIND_ALL=1 lets a published port reach the UI. dsh listens on
# 127.0.0.1 by default and refuses wildcard addresses such as 0.0.0.0, so the
# Web UI binds the container's own address instead, which is where Docker
# forwards a published port. It goes before the container arguments, so a
# --host there still wins.
if [ "${DSH_YAWN_BIND_ALL:-0}" = 1 ]; then
  address=$(hostname -i | awk '{print $1}')
  if [ -z "$address" ]; then
    echo "dsh-yawn: DSH_YAWN_BIND_ALL=1, but hostname -i reported no address to bind." >&2
    exit 1
  fi
  set -- --host "$address" "$@"
fi
# The control plane ships two sign-in modes. One of them is required: the
# launch-token route is gone, so an unconfigured container must not fall back
# to reading a token from the log.
if [ "${DSH_YAWN_CONTROL_PLANE_LAUNCH_TOKEN_ROUTE:-0}" = 1 ]; then
  echo "dsh-yawn: the launch-token route was removed; set DSH_YAWN_PASSCODE or DSH_YAWN_OIDC_ISSUER." >&2
  exit 1
fi
auth_mode=""
if [ -n "${DSH_YAWN_OIDC_ISSUER:-}" ]; then
  auth_mode=oidc
fi
if [ -n "${DSH_YAWN_PASSCODE:-}" ]; then
  if [ "$auth_mode" = oidc ]; then
    echo "dsh-yawn: set either DSH_YAWN_PASSCODE or DSH_YAWN_OIDC_ISSUER, not both." >&2
    exit 1
  fi
  auth_mode=passcode
fi
case "$auth_mode" in
  passcode)
    if [ "${#DSH_YAWN_PASSCODE}" -lt 8 ]; then
      echo "dsh-yawn: DSH_YAWN_PASSCODE must be at least 8 characters." >&2
      exit 1
    fi
    set -- --patch /opt/dsh-yawn/passcode-auth.patch.yml "$@"
    ;;
  oidc)
    if [ -z "${DSH_YAWN_OIDC_ISSUER:-}" ] \
      || [ -z "${DSH_YAWN_OIDC_CLIENT_ID:-}" ] \
      || [ -z "${DSH_YAWN_OIDC_REDIRECT_URL:-}" ]; then
      echo "dsh-yawn: DSH_YAWN_OIDC_ISSUER, DSH_YAWN_OIDC_CLIENT_ID, and DSH_YAWN_OIDC_REDIRECT_URL must be set for OIDC sign-in." >&2
      exit 1
    fi
    if [ -z "${DSH_YAWN_OIDC_ALLOWED_EMAILS:-}" ] && [ -z "${DSH_YAWN_OIDC_ALLOWED_DOMAINS:-}" ]; then
      echo "dsh-yawn: set DSH_YAWN_OIDC_ALLOWED_EMAILS or DSH_YAWN_OIDC_ALLOWED_DOMAINS." >&2
      exit 1
    fi
    set -- --patch /opt/dsh-yawn/oidc-auth.patch.yml "$@"
    ;;
  *)
    echo "dsh-yawn: set DSH_YAWN_PASSCODE, or DSH_YAWN_OIDC_ISSUER with its OIDC settings." >&2
    exit 1
    ;;
esac
exec dsh --profile web "$@"
